#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Mac mode is below the functional layers so the trackball sees Mouse/Scroll.
 * The preview numbers are logical; ZMK indices are shifted by the Mac layer. */

#define LAYER_BASE 0
#define LAYER_MAC 1
#define LAYER_SYMBOLS 2
#define LAYER_EDIT 3
#define LAYER_MAC_EDIT 4
#define LAYER_NUMBER 5
#define LAYER_MOUSE 6
#define LAYER_SCROLL 7
#define LAYER_BLUETOOTH 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <LAYER_MOUSE>;
    scroll-layers = <LAYER_SCROLL>;
};

/ {
    combos {
        compatible = "zmk,combos";

        esc_qw {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <LAYER_BASE LAYER_MAC>;
        };

        grave_op {
            bindings = <&kp GRAVE>;
            key-positions = <8 9>;
            layers = <LAYER_BASE LAYER_MAC>;
        };

        yen_vb {
            bindings = <&kp INT_YEN>;
            key-positions = <25 26>;
            layers = <LAYER_BASE LAYER_MAC>;
        };

        /* Original roBa combos, adapted to the reviewed base layer. */

        tab_sd {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <LAYER_BASE LAYER_MAC>;
        };

        shift_tab_df {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            layers = <LAYER_BASE LAYER_MAC>;
        };

        muhennkan_as_windows {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <10 11>;
            layers = <LAYER_BASE>;
        };

        eisu_as_mac {
            bindings = <&kp LANG1>;
            key-positions = <10 11>;
            layers = <LAYER_MAC>;
        };

        double_quote_l_semicolon {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
            layers = <LAYER_BASE LAYER_MAC>;
        };

        equal_cv {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
            layers = <LAYER_BASE LAYER_MAC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        mac_edit {
            if-layers = <LAYER_MAC LAYER_EDIT>;
            then-layer = <LAYER_MAC_EDIT>;
        };
    };

    behaviors {
        os_bt: os_mode_or_bluetooth {
            compatible = "zmk,behavior-hold-tap";
            label = "OS_MODE_OR_BLUETOOTH";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };

        shot_scroll: screenshot_or_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "SCREENSHOT_OR_SCROLL";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Windows";
            bindings = <
&kp Q             &kp W     &kp E     &kp R                         &kp T                                                                                            &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A             &kp S     &kp D     &kp F                         &kp G                 &shot_scroll LAYER_SCROLL LG(LS(S))      &os_bt LAYER_BLUETOOTH LAYER_MAC  &kp H          &kp J  &kp K      &kp L    &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X     &kp C     &kp V                         &kp B                 &kp LEFT_BRACKET                         &kp RIGHT_BRACKET                 &kp N          &kp M  &kp COMMA  &kp DOT  &lt LAYER_SCROLL SLASH
&kp LCTRL         &kp LGUI  &kp LALT  &lt LAYER_SYMBOLS LANGUAGE_1  &lt LAYER_EDIT SPACE  &lt 7 LANGUAGE_2                         &kp ENTER                         &kp BACKSPACE                             &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        mac {
            display-name = "Mac";
            bindings = <
&trans    &trans     &trans  &trans                   &trans                                                                                  &trans  &trans  &trans  &trans  &trans
&trans    &trans     &trans  &trans                   &trans  &shot_scroll LAYER_SCROLL LC(LS(LG(N4)))      &os_bt LAYER_BLUETOOTH LAYER_MAC  &trans  &trans  &trans  &trans  &trans
&trans    &trans     &trans  &trans                   &trans  &trans                                        &trans                            &trans  &trans  &trans  &trans  &trans
&kp LGUI  &kp LCTRL  &trans  &lt LAYER_SYMBOLS LANG2  &trans  &lt LAYER_SCROLL LANG1                        &trans                            &trans                          &trans
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                      &kp CARET  &kp AMPERSAND  &kp ASTERISK          &kp MINUS              &kp EQUAL
&kp N1           &kp N2       &kp N3    &kp N4      &kp N5       &trans      &trans  &kp N6     &kp N7         &kp N8                &kp N9                 &kp N0
&kp F1           &kp F2       &kp F3    &kp F4      &kp F5       &trans      &trans  &kp F12    &kp F7         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&trans           &trans       &trans    &trans      &trans       &trans      &trans  &trans                                                                 &trans
            >;
        };

        edit {
            display-name = "Ctrl-Edit";
            bindings = <
&kp LC(Q)             &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)                                               &kp LC(Y)  &kp LC(U)  &kp LC(I)  &kp LC(O)  &kp LC(P)
&kp LC(A)             &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(G)  &trans                  &trans               &kp LC(H)  &mkp MB1   &kp UP     &mkp MB2   &trans
&mt LEFT_SHIFT LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &kp LA(LEFT_ARROW)      &kp RA(RIGHT_ARROW)  &kp LC(N)  &kp LEFT   &kp DOWN   &kp RIGHT  &trans
&trans                &trans     &trans     &trans     &trans     &trans                  &kp LS(ENTER)        &trans                                      &trans
            >;
        };

        mac_edit {
            display-name = "Mac-Edit";
            bindings = <
&kp LG(Q)             &kp LG(W)  &kp LG(E)  &kp LG(R)  &kp LG(T)                      &kp LG(LS(Z))  &kp LG(U)  &kp LG(I)  &kp LG(O)  &kp LG(P)
&kp LG(A)             &kp LG(S)  &kp LG(D)  &kp LG(F)  &kp LG(G)  &trans      &trans  &kp LG(H)      &kp LG(J)  &trans     &kp LG(L)  &trans
&mt LEFT_SHIFT LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LG(N)      &trans     &trans     &trans     &trans
&trans                &trans     &trans     &trans     &trans     &trans      &trans  &trans                                          &trans
            >;
        };

        number {
            display-name = "Number";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE    &kp KP_MULTIPLY
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS     &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0  &kp KP_DOT
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                              &trans
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        scroll {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        bluetooth {
            display-name = "Bluetooth";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &bootloader   &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
