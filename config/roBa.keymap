#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Keyball61 cheat sheet -> roBa, 2026-09-26.
 * Positions follow config/roBa.json (10 + 12 + 12 + 9).
 * Layers: 0 base, 1 symbols, 2 navigation, 3 numpad,
 *         4 automatic mouse, 5 scroll, 6 Bluetooth.
 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        esc_qw {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        grave_op {
            bindings = <&kp GRAVE>;
            key-positions = <8 9>;
            layers = <0>;
        };

        left_bracket_zx {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <23 24>;
            layers = <0>;
        };

        right_bracket_comma_dot {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
            layers = <0>;
        };

        yen_vb {
            bindings = <&kp INT_YEN>;
            key-positions = <26 27>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                  &kp W         &kp E          &kp R          &kp T          &kp Y          &kp U          &lt 5 I        &kp O           &kp P
&mt LEFT_CONTROL TAB   &kp A         &kp S          &kp D          &kp F          &kp G          &kp H          &kp J          &kp K           &kp L          &kp SEMICOLON  &mt RIGHT_CONTROL SQT
&kp LEFT_SHIFT         &kp Z         &kp X          &kp C          &kp V          &kp B          &kp N          &kp M          &kp COMMA       &kp DOT        &kp SLASH      &kp RIGHT_SHIFT
&kp LEFT_CONTROL       &kp LEFT_WIN  &kp LEFT_ALT   &lt_to_layer_0 6 INT_HENKAN  &lt 2 SPACE  &lt_to_layer_0 3 INT_MUHENKAN  &kp BACKSPACE  &lt 1 ENTER  &kp DEL
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        SYMBOL {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR   &kp PERCENT   &kp CARET      &kp AMPERSAND  &kp ASTERISK    &kp MINUS      &kp EQUAL
&trans           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3 &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6   &kp NUMBER_7    &kp NUMBER_8   &kp NUMBER_9  &kp NUMBER_0  &kp BACKSLASH
&trans           &kp F1        &kp F2        &kp F3       &kp F4        &kp F5         &kp F6         &kp F7          &kp F8         &kp F9        &kp F10       &kp F11
&trans           &trans        &trans        &trans       &trans        &trans         &trans         &trans          &kp F12
            >;
        };

        NAV {
            bindings = <
&trans  &kp F1      &kp F2      &kp F3      &kp F4      &kp F5       &kp F6      &kp F7         &kp F8         &kp F9
&trans  &kp LG(E)   &kp TAB     &kp LC(S)   &kp LC(F)   &kp LG(H)    &kp LC(Y)   &kp LC(I)      &kp HOME       &kp END         &kp F10  &kp F11
&trans  &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp LC(B)    &kp PG_UP   &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &kp UP_ARROW &kp PG_DN
&trans  &trans      &trans      &trans      &trans      &trans       &trans      &trans         &kp F12
            >;
            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE    &kp KP_MULTIPLY
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS  &kp KP_PLUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0  &kp KP_DOT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans        &bootloader   &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };
    };
};
